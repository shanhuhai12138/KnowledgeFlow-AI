# KnowledgeFlow AI — 根目录 .gitignore

# ---- 环境与密钥（绝不入库） ----
.env
.env.*
!.env.example

# ---- 日志 ----
*.log

# ---- IDE / 编辑器 ----
.idea/
.vscode/
*.iml

# ---- 前端 ----
frontend/node_modules/
frontend/dist/

# ---- 后端 ----
backend/target/
backend/*.class
backend/.flattened-pom.xml
backend/*/.flattened-pom.xml

# ---- Python ----
ai-service/.venv/
ai-service/__pycache__/
ai-service/*.pyc

# ---- 系统 ----
.DS_Store
Thumbs.db

# ---- 构建产物 ----
backend/yudao-ui.bak/
backend/scripts/

# ---- ���������ļ� ----
*DESIGN*.md
*PLAN*.md
*ANALYSIS*.md
*OPTIMIZATION*.md
*BEAUTIFICATION*.md

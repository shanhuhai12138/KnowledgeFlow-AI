# KnowledgeFlow AI 基础设施环境变量（示例）
# 使用：复制为 .env（docker compose 自动读取）
#   cp .env.example .env
# 开发默认值可直接使用，无需本机任何密码。
# 若本机端口冲突发生变化，修改 docker-compose.yml 的宿主映射
# 并同步后端/前端连接配置。

# ============================================================
# 安全提示：生产环境务必修改所有默认密码！
# ============================================================

# --- MySQL（容器内端口 3306，宿主映射 3307）---
MYSQL_ROOT_PASSWORD=knowledgeflow
MYSQL_DATABASE=knowledgeflow
MYSQL_USER=knowledgeflow
MYSQL_PASSWORD=knowledgeflow

# --- MinIO（API 9000 / 控制台 9001）---
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# --- AI 服务（容器版经 compose 注入，不进镜像）---
# LLM_API_KEY：DeepSeek API Key（与 ai-service/.env 一致），不配置时问答/Agent 会报「请配置 API Key」
LLM_API_KEY=
# LLM_MODEL：模型名，默认 deepseek-chat
LLM_MODEL=deepseek-chat
# CONFIG_SECRET：AES 加密密钥（T7 API Key 存储；留空则启动时随机生成并打印一次）
CONFIG_SECRET=

# --- CORS 来源（逗号分隔，默认开发环境）---
# CORS_ORIGINS=http://localhost:8080,http://localhost:5173
# 生产环境请改为实际域名，如：CORS_ORIGINS=https://yourdomain.com
# CORS_ORIGINS=http://localhost:8080
